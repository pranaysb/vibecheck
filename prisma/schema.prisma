// All tables live in their own "vibecheck" schema, so `prisma db push` never touches other
// tables in the same database (e.g. Neon Auth or pre-rebuild data in "public").
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["vibecheck"]
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  /// Clerk user id. Sign-in, email verification and sessions are handled by Clerk.
  clerkId   String?  @unique
  /// The user's Clerk-verified primary email (ADMIN_EMAILS is matched against it).
  email     String   @unique
  name      String
  createdAt DateTime @default(now())

  /// Legacy (pre-Clerk) auth columns, unused. Dropped once the migration is deployed.
  passwordHash    String?
  emailVerifiedAt DateTime?

  sessions        Session[]
  audits          Audit[]
  expertProfile   ExpertProfile?
  requests        ReviewRequest[] @relation("Requester")
  claimedRequests ReviewRequest[] @relation("Expert")
  expertReviews   ExpertReview[]

  @@schema("vibecheck")
}

enum CodePurpose {
  VERIFY
  SIGNIN

  @@schema("vibecheck")
}

/// Legacy (pre-Clerk), unused. Dropped once the migration is deployed.
model EmailCode {
  id         String      @id @default(cuid())
  email      String
  purpose    CodePurpose
  codeHash   String
  attempts   Int         @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime    @default(now())

  @@index([email, purpose, createdAt])
  @@schema("vibecheck")
}

/// Legacy (pre-Clerk), unused. Dropped once the migration is deployed.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])

  @@schema("vibecheck")
}

enum ExpertStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("vibecheck")
}

model ExpertProfile {
  id         String       @id @default(cuid())
  userId     String       @unique
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline   String
  bio        String       @db.Text
  expertise  String[]
  links      String[]
  status     ExpertStatus @default(PENDING)
  decidedAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status])

  @@schema("vibecheck")
}

enum AuditSource {
  URL
  ZIP
  GITHUB

  @@schema("vibecheck")
}

enum AuditStatus {
  RUNNING
  COMPLETED
  FAILED

  @@schema("vibecheck")
}

model Audit {
  id         String      @id @default(cuid())
  source     AuditSource
  target     String
  finalUrl   String?
  label      String
  status     AuditStatus @default(RUNNING)
  error      String?     @db.Text
  score      Int?
  checks     Json?
  meta       Json?
  durationMs Int?
  ownerId    String?
  owner      User?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())

  files       AuditFile[]
  screenshots Screenshot[]
  requests    ReviewRequest[]

  @@index([ownerId])
  @@index([createdAt])

  @@schema("vibecheck")
}

model AuditFile {
  id          String @id @default(cuid())
  auditId     String
  audit       Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)
  path        String
  contentType String
  size        Int
  data        Bytes

  @@unique([auditId, path])

  @@schema("vibecheck")
}

model Screenshot {
  id      String @id @default(cuid())
  auditId String
  audit   Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)
  kind    String
  width   Int
  height  Int
  data    Bytes

  @@unique([auditId, kind])

  @@schema("vibecheck")
}

enum RequestStatus {
  OPEN
  CLAIMED
  COMPLETED
  CANCELLED

  @@schema("vibecheck")
}

model ReviewRequest {
  id          String        @id @default(cuid())
  auditId     String
  audit       Audit         @relation(fields: [auditId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User          @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  focus       String[]
  notes       String        @db.Text
  status      RequestStatus @default(OPEN)
  expertId    String?
  expert      User?         @relation("Expert", fields: [expertId], references: [id], onDelete: SetNull)
  claimedAt   DateTime?
  createdAt   DateTime      @default(now())

  review ExpertReview?

  @@index([status])
  @@index([requesterId])
  @@index([expertId])

  @@schema("vibecheck")
}

enum Verdict {
  SHIP
  FIX_FIRST
  NOT_READY

  @@schema("vibecheck")
}

model ExpertReview {
  id          String        @id @default(cuid())
  requestId   String        @unique
  request     ReviewRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  expertId    String
  expert      User          @relation(fields: [expertId], references: [id], onDelete: Cascade)
  verdict     Verdict
  summary     String        @db.Text
  findings    Json
  rating      Int?
  ratingNote  String?       @db.Text
  createdAt   DateTime      @default(now())

  @@index([expertId])

  @@schema("vibecheck")
}
