# Postgres connection string. Include your Postgres user (on macOS/Homebrew it's your login name).
DATABASE_URL="postgresql://YOUR_USER@localhost:5432/vibecheck"

# Comma-separated emails that get the /admin console (approve or decline expert applications).
ADMIN_EMAILS="admin@vibecheck.test"

# Signs sandboxed preview links. Any long random string (openssl rand -hex 32).
SESSION_SECRET=""

# Clerk (sign-up, sign-in, email verification, Google/GitHub). `npx clerk@latest init` fills these;
# it writes temporary dev keys and needs no Clerk account.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Optional
# GITHUB_TOKEN=            # raises GitHub API rate limit for repo imports (public repos only either way)
# MAX_UPLOAD_MB=25         # .zip upload limit. Vercel caps request bodies at 4.5 MB; self-host for larger.
# CHROMIUM_PATH=           # use a specific Chrome/Chromium binary for the browser checks
# CHROMIUM_PACK_URL=       # serverless only: @sparticuz/chromium pack to download

# Admin access needs an email that Clerk has verified and that is listed in ADMIN_EMAILS.
