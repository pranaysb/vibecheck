{
  "name": "vibecheck",
  "version": "1.4.2",
  "description": "Enterprise code quality benchmarks, SSRF-defended automated remote audits, and cryptographic attestation platform built on Next.js 16.",
  "license": "MIT",
  "author": "Pranay S. B. <pranaystudies22@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/pranaysb/vibecheck.git"
  },
  "homepage": "https://vibecheck-ten-omega.vercel.app",
  "keywords": [
    "security",
    "ssrf-prevention",
    "code-quality",
    "audit",
    "cryptographic-attestation",
    "nextjs",
    "turbopack",
    "vercel"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && (prisma db push --accept-data-loss || true) && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx --test tests/**/*.test.ts",
    "seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "playwright": "^1.62.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
